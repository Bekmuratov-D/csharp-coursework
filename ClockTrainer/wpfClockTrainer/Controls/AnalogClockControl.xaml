<UserControl x:Class="ClockTrainer.Wpf.Controls.AnalogClockControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="220" d:DesignHeight="220">
    <Viewbox Stretch="Uniform">
        <Canvas x:Name="RootCanvas" Width="220" Height="220"
                Background="Transparent"
                MouseLeftButtonDown="RootCanvas_MouseLeftButtonDown"
                MouseMove="RootCanvas_MouseMove"
                MouseLeftButtonUp="RootCanvas_MouseLeftButtonUp">

            <Ellipse x:Name="FaceEllipse" Width="206" Height="206" Canvas.Left="7" Canvas.Top="7"
                     Fill="{DynamicResource ClockFaceBrush}"
                     Stroke="{DynamicResource ClockBorderBrush}" StrokeThickness="4">
                <Ellipse.Effect>
                    <DropShadowEffect Color="#7C4DFF" Opacity="0.22" BlurRadius="18" ShadowDepth="4"/>
                </Ellipse.Effect>
            </Ellipse>

            <!-- tick marks and numbers are generated in code-behind -->

            <Border x:Name="PeriodBadge" Width="42" Height="22" CornerRadius="11"
                    Canvas.Left="89" Canvas.Top="138"
                    Background="{DynamicResource SurfaceAltBrush}"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="PeriodBadgeScale" ScaleX="1" ScaleY="1"/>
                </Border.RenderTransform>
                <TextBlock x:Name="PeriodBadgeText" Text="AM" FontSize="11" FontFamily="Segoe UI Semibold"
                           Foreground="{DynamicResource PrimaryBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <Line x:Name="HourHandLine" X1="110" Y1="110" X2="110" Y2="60"
                  Stroke="{DynamicResource HourHandBrush}" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                <Line.RenderTransform>
                    <RotateTransform x:Name="HourRotate" Angle="0" CenterX="110" CenterY="110"/>
                </Line.RenderTransform>
            </Line>

            <Line x:Name="MinuteHandLine" X1="110" Y1="110" X2="110" Y2="35"
                  Stroke="{DynamicResource MinuteHandBrush}" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                <Line.RenderTransform>
                    <RotateTransform x:Name="MinuteRotate" Angle="0" CenterX="110" CenterY="110"/>
                </Line.RenderTransform>
            </Line>

            <Ellipse Width="12" Height="12" Canvas.Left="104" Canvas.Top="104"
                     Fill="{DynamicResource ClockBorderBrush}"/>
        </Canvas>
    </Viewbox>
</UserControl>
