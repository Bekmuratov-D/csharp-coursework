<Window x:Class="ClockTrainer.Wpf.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="⚙️ Настройки" Width="320" Height="260"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}">
    <StackPanel Margin="24">
        <TextBlock Text="🎨 Тема" FontFamily="Segoe UI Semibold" FontSize="15"
                   Foreground="{DynamicResource TextBrush}" Margin="0,0,0,12"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,24">
            <RadioButton x:Name="LightRadio" GroupName="Theme" Style="{StaticResource ChipToggleButton}" Content="☀️ Светлая"/>
            <RadioButton x:Name="DarkRadio" GroupName="Theme" Style="{StaticResource ChipToggleButton}" Content="🌙 Тёмная"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="✅ ОК" Style="{StaticResource PillButton}" Width="120" Margin="0,0,10,0" Click="OkButton_Click"/>
            <Button Content="Отмена" Style="{StaticResource GhostButton}" Width="120" Click="CancelButton_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
