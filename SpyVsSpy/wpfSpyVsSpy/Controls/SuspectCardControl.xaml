<UserControl x:Class="SpyVsSpy.Wpf.Controls.SuspectCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="96" Height="104">
    <Border x:Name="CardBorder" CornerRadius="8" BorderThickness="3" BorderBrush="Transparent"
            Background="{StaticResource CardBrush}"
            MouseLeftButtonUp="CardBorder_MouseLeftButtonUp"
            RenderTransformOrigin="0.5,0.5">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.4" BlurRadius="8" ShadowDepth="2"/>
        </Border.Effect>
        <Border.RenderTransform>
            <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
        </Border.RenderTransform>
        <Grid Margin="6">
            <StackPanel VerticalAlignment="Center">
                <Grid Width="36" Height="36" Margin="0,0,0,6">
                    <Ellipse x:Name="AvatarEllipse" Fill="{StaticResource AccentBrush}"/>
                    <TextBlock x:Name="AvatarInitials" Text="??" FontFamily="Segoe UI Black" FontSize="13"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock x:Name="DeadMark" Text="✕" FontSize="24" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="Collapsed"/>
                </Grid>
                <TextBlock x:Name="NameText" Text="Имя" FontFamily="Segoe UI Semibold" FontSize="11"
                           TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{StaticResource CardTextBrush}"/>
            </StackPanel>

            <Border x:Name="SelfBadge" Background="{StaticResource GoldBrush}" CornerRadius="6" Height="16"
                    VerticalAlignment="Top" HorizontalAlignment="Center" Padding="6,0" Margin="0,-2,0,0"
                    Visibility="Collapsed">
                <TextBlock Text="ВЫ" FontSize="9" FontWeight="Bold" Foreground="#241A10"/>
            </Border>
        </Grid>
    </Border>
</UserControl>
